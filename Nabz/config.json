      "noavx2": "whisper.cpp/build-noavx2/bin/whisper-cli",
      "gpu": "whisper.cpp/build-gpu/bin/whisper-cli"
    },
    "models": {
      "base-q8": "whisper.cpp/models/ggml-base-q8_0.bin",
      "small-q8": "whisper.cpp/models/ggml-small-q8_0.bin",
